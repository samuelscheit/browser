# Never send local installs, VCS state, credentials, artifacts, or generated caches to the Docker
# daemon. Every runtime image restores dependencies from the committed Bun lockfile.
.git
.gitignore
node_modules
**/node_modules
.bun
.env
.env.*
!.env.example
deploy/compose/secrets
deploy/compose/.env
coverage
dist
artifacts
__pycache__
**/__pycache__
*.py[cod]
*.log
.DS_Store
tests
docs
