    "profile_default",
    "profile_default-g2"
  ],
  "resourceLimits": {
    "maxBrowserLeases": 4,
    "cpuMilli": 2000,
    "memoryMiB": 4096,
    "pids": 512,
    "shmMiB": 1024,
    "temporaryStorageMiB": 4096
  },
  "lastHeartbeatAt": "1970-01-01T00:00:00.000Z",
