{
	auto_https off
	admin off
}

# Put a TLS terminator (a reverse proxy or tunnel) in front of this listener. Application callers use a normal
# per-principal Basic credential; Caddy validates it against bcrypt hashes
# generated from the mounted principal passwords by caddy-entrypoint.sh. Caddy then injects the
# authenticated principal over the private origin mTLS connection.
:8080 {
	@health path /healthz
	handle @health {
		reverse_proxy https://{$FABRIC_API_ORIGIN}:8080 {
			transport http {
				tls_server_name fabric-api
				tls_trust_pool file {
					pem_file /run/secrets/fabric_origin_server_ca
				}
				tls_client_auth /run/secrets/fabric_edge_origin_client_cert /run/secrets/fabric_edge_origin_client_key
			}
		}
	}

	# All API and CDP paths require a credential. The username is an opaque
	# principal ID, not a caller-controlled identity header.
	@protected {
		not path /healthz
	}
	# One "principal_<name> <bcrypt hash>" line per mounted principal password,
	# generated by caddy-entrypoint.sh.
	basic_auth @protected {
		{$FABRIC_EDGE_BASIC_AUTH_ACCOUNTS}
	}

	# A rejected credential says what Fabric expects instead of an empty 401.
	handle_errors 401 {
		header Content-Type "text/plain; charset=utf-8"
		respond "Browser Fabric rejected this credential. The Basic username is the principal ID (for example principal_admin), the password is that principal's application password. Start with GET /v1/me." 401
	}

	@cdp path /v1/cdp/*
	handle @cdp {
		reverse_proxy https://{$FABRIC_CDP_ORIGIN}:8081 {
			header_up -Authorization
			header_up -X-Fabric-MTLS-Verified
			header_up X-Fabric-Edge-Authenticated "true"
			header_up X-Fabric-Principal "{http.auth.user.id}"
			transport http {
				tls_server_name fabric-cdp-gateway
				tls_trust_pool file {
					pem_file /run/secrets/fabric_origin_server_ca
				}
				tls_client_auth /run/secrets/fabric_edge_origin_client_cert /run/secrets/fabric_edge_origin_client_key
			}
		}
	}

	handle {
		reverse_proxy https://{$FABRIC_API_ORIGIN}:8080 {
			header_up -Authorization
			header_up -X-Fabric-MTLS-Verified
			header_up X-Fabric-Edge-Authenticated "true"
			header_up X-Fabric-Principal "{http.auth.user.id}"
			transport http {
				tls_server_name fabric-api
				tls_trust_pool file {
					pem_file /run/secrets/fabric_origin_server_ca
				}
				tls_client_auth /run/secrets/fabric_edge_origin_client_cert /run/secrets/fabric_edge_origin_client_key
			}
		}
	}
}
