{
  "version": 1,
  "projects": [
    { "id": "project_research", "name": "Research" }
  ],
  "challengeSets": [
    {
      "name": "solver-anticaptcha-only",
      "handlers": [
        { "id": "guardian", "kind": "guardian", "mode": "automatic", "configuration": { "solver": "llm-captcha" } },
        { "id": "anticaptcha", "kind": "anticaptcha", "mode": "automatic" }
      ]
    }
  ],
  "egressPolicies": [
    {
      "name": "proxy-static-direct",
      "routes": {
        "document": { "kind": "proxy", "proxyRef": "default", "protocol": "http" },
        "api": { "kind": "proxy", "proxyRef": "default", "protocol": "http" },
        "websocket": { "kind": "proxy", "proxyRef": "default", "protocol": "http" },
        "browser_download": { "kind": "proxy", "proxyRef": "default", "protocol": "http" },
        "static_asset": { "kind": "direct" }
      }
    }
  ],
  "recipes": [
    {
      "name": "chrome-de",
      "runtime": "chrome",
      "profileFamily": "default",
      "mode": "interactive",
      "access": "raw_cdp",
      "challengeHandlerSetRef": "challenge_solver-anticaptcha-only@1",
      "launch": { "locale": "de-DE", "timezone": "Europe/Berlin", "viewport": { "width": 1366, "height": 768 } }
    }
  ]
}
