# Copy to .env next to compose.yml and adjust. Never commit .env or secrets/.

# Public base URL of the CDP gateway. Session CDP endpoints are built from it, so it must name the
# TLS terminator in front of fabric-edge (wss://...), or the edge itself on loopback for local use.
FABRIC_GATEWAY_BASE_URL=ws://127.0.0.1:18086

# Where fabric-edge listens on the host. Keep it on loopback and put a TLS reverse proxy or tunnel
# in front; bind 0.0.0.0 only behind your own TLS-terminating firewall.
FABRIC_EDGE_BIND=127.0.0.1
FABRIC_EDGE_PORT=18086

# Concurrent browser leases across the deployment (1 to 8).
FABRIC_MAX_ACTIVE_BROWSER_LEASES=4

# Secret bundle written by ./bootstrap-secrets.sh (default ./secrets).
# FABRIC_SECRETS_DIR=./secrets

# Deployment catalog (recipes, egress policies, challenge sets, projects); see docs/catalog.md.
# FABRIC_CATALOG_PATH=./catalog.json

# Egress sidecar listeners/policies; add a listener here when a catalog policy names a new one.
# FABRIC_EGRESS_CONFIG_PATH=./egress-sidecar.json
