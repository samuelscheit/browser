{
  "version": 1,
  "listeners": [
    { "id": "direct", "port": 11000, "bindHost": "127.0.0.1", "mode": "direct" },
    {
      "id": "proxy",
      "port": 11001,
      "bindHost": "127.0.0.1",
      "mode": "proxy",
      "upstreamSecretFile": "/absolute/path/outside/repository/proxy-url"
    }
  ],
  "policies": [
    { "ref": "egress_direct@1", "defaultListenerId": "direct" },
    { "ref": "egress_proxy@1", "defaultListenerId": "proxy" }
  ]
}
